<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for System.Drawing (tray icon rendering); no WinForms UI is used. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Function pointers into the GPU vendor driver libraries (NVAPI / ADL / IGCL). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FastRes</AssemblyName>
    <RootNamespace>FastRes</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FastRes.ico</ApplicationIcon>
    <Product>FastRes</Product>
    <Description>Quick screen resolution and refresh rate switcher for the Windows tray</Description>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WinForms analyzer: DPI awareness is intentionally set in app.manifest for WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\FastRes.ico" />
  </ItemGroup>

</Project>
