<Window x:Class="FastRes.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FastRes"
        Title="FastRes"
        Width="360" SizeToContent="Height"
        WindowStyle="ToolWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{DynamicResource RootBackground}">
        <Grid x:Name="Root">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Slide" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="Body" Margin="16,18,16,12">

                <!-- Header: current mode of the selected display -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentFill}">
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{DynamicResource TextOnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CurrentText" FontFamily="{StaticResource DisplayFont}" FontSize="20"
                                   FontWeight="SemiBold" Text="—" />
                        <TextBlock x:Name="DetailText" FontSize="12" Margin="0,1,0,0"
                                   Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <!-- Display picker (only shown with more than one display) -->
                <ItemsControl x:Name="MonitorList" Margin="0,16,0,-6" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:MonitorItem}">
                            <Button Style="{StaticResource ChipButton}" local:Ui.IsCurrent="{Binding IsSelected}"
                                    ToolTip="{Binding Tooltip}" Click="Monitor_Click"
                                    AutomationProperties.Name="{Binding Tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" Margin="8,0,0,0" MaxWidth="130"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Resolution" Style="{StaticResource SectionHeader}" />
                <ScrollViewer x:Name="ResScroll" Style="{StaticResource ModernScrollViewer}"
                              MaxHeight="290" Margin="-6,0,-10,0" Padding="6,0,10,0">
                    <ItemsControl x:Name="ResList" Focusable="False"
                                  KeyboardNavigation.DirectionalNavigation="Contained">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ResolutionItem}">
                                <Button Style="{StaticResource ListItemButton}" local:Ui.IsCurrent="{Binding IsCurrent}"
                                        Click="Resolution_Click" AutomationProperties.Name="{Binding Label}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="Recommended" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentFill}"
                                                   Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Aspect}" FontSize="12"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Refresh rate" Style="{StaticResource SectionHeader}" />
                <ItemsControl x:Name="RateList" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:RateItem}">
                            <Button Style="{StaticResource ChipButton}" local:Ui.IsCurrent="{Binding IsCurrent}"
                                    Content="{Binding Label}" Click="Rate_Click"
                                    AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Colour: legacy desktop depths (if the driver offers them), SDR/HDR, and output bit depth -->
                <StackPanel x:Name="ColorSection">
                    <TextBlock Text="Color" Style="{StaticResource SectionHeader}" />
                    <ItemsControl x:Name="DepthList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ColorItem}">
                                <Button Style="{StaticResource ChipButton}" local:Ui.IsCurrent="{Binding IsCurrent}"
                                        Content="{Binding Label}" ToolTip="{Binding Tooltip}" Click="Color_Click"
                                        AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl x:Name="ColorList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ColorItem}">
                                <Button Style="{StaticResource ChipButton}" local:Ui.IsCurrent="{Binding IsCurrent}"
                                        Content="{Binding Label}" ToolTip="{Binding Tooltip}" Click="Color_Click"
                                        AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ColorDetail" FontSize="12" Margin="2,0,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <!-- Inline error -->
                <Border x:Name="ErrorBar" Visibility="Collapsed" CornerRadius="4" Padding="10,8" Margin="0,6,0,0"
                        Background="{DynamicResource ErrorFill}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xEA39;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,10,0"
                                   Foreground="{DynamicResource ErrorText}" VerticalAlignment="Top" />
                        <TextBlock x:Name="ErrorText" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="1" Background="{DynamicResource FooterFill}"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                <Grid Margin="8">
                    <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Click="DisplaySettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Display settings" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Right"
                            Width="36" Padding="0" Click="More_Click" ToolTip="Options"
                            AutomationProperties.Name="Options">
                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
